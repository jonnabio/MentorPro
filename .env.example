# OpenAI Configuration (Required for local development)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenRouter Configuration (for additional models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Production Database Configuration (Required for Render.com deployment)
# Get this from your Supabase project: Project Settings -> Database -> Connection string
SUPABASE_URL=postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres

# Environment (automatically set by Render.com)
NODE_ENV=development
PORT=3000
